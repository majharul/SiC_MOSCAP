flowchart TB
    %% Visual abstract for SiC MOSCAP C-V modeling
    A[Fabricated SiC MOSCAP] --> B[Measured C-V characteristics]
    A --> C[Surface-potential based analytical model]

    subgraph M[Core Physics Model]
        C --> C1[Solve surface potential numerically]
        C1 --> C2[Ideal MOSCAP C-V prediction]
        C2 --> C3[Electrostatic charge balance]
        C3 --> C4[Capacitance-voltage response]
    end

    subgraph N[Non-Ideal Effects]
        N1[Fixed oxide charge Qox]
        N2[Interface trap density Dit]
        N3[Terminal impedance / Rs]
        N4[Minority carrier generation lifetime]
        N5[Frequency dispersion and tunneling]
    end

    C4 --> D[Add non-ideal terms to model]
    N1 --> D
    N2 --> D
    N3 --> D
    N4 --> D
    N5 --> D

    D --> E[Corrected simulated C-V curves]
    B --> F[Experimental validation]
    E --> F
    F --> G[Reduced mismatch between theory and measurement]
    G --> H[Validated SiC MOSCAP model]
    H --> I[Design guidance for SiC CMOS and high-temperature devices]

    subgraph U[Interactive Analysis Tool]
        J[Slider-based exploration]
        K[Parameter sensitivity study]
        L[Real-time comparison with measured data]
    end

    D --> U
    U --> H

    classDef core fill:#e8f1ff,stroke:#1f4e79,stroke-width:1.5px,color:#0b1f33;
    classDef nonideal fill:#fff2cc,stroke:#a67c00,stroke-width:1.5px,color:#4d3800;
    classDef validate fill:#e2f0d9,stroke:#2f7d32,stroke-width:1.5px,color:#123b14;
    classDef tool fill:#f3e8ff,stroke:#6f42c1,stroke-width:1.5px,color:#2e1a55;

    class C,C1,C2,C3,C4 core;
    class N1,N2,N3,N4,N5,D nonideal;
    class B,F,G,H,I validate;
    class J,K,L,U tool;
